# Canonical origin for the deployed site.
#
# Read by astro.config.mjs (sets `site:`) and by src/lib/site.ts (canonical
# URLs, Open Graph tags, RSS, JSON-LD). No trailing slash.
#
# - local dev  : leave unset; both fall back to http://localhost:4321
# - Vercel prod: https://<your-domain>
# - Vercel prev: Vercel's generated preview URL, or leave unset
SITE_URL=http://localhost:4321

# Injected automatically by Vercel; never set by hand in production.
# One of: production | preview | development.
# Anything other than "production" makes every page emit
# `<meta name="robots" content="noindex, nofollow">` (see src/lib/site.ts).
# VERCEL_ENV=development
