# Canonical origin for the deployed site.
#
# Read by astro.config.mjs (sets `site:`) and by src/lib/site.ts (canonical
# URLs, Open Graph tags, RSS, JSON-LD). No trailing slash.
#
# - local dev  : leave unset; both fall back to http://localhost:4321
# - Vercel prod: https://<your-domain>
# - Vercel prev: Vercel's generated preview URL, or leave unset
SITE_URL=http://localhost:4321

# Injected automatically by Vercel; never set by hand in production.
# One of: production | preview | development.
#
# Read twice in src/lib/site.ts, both times as `VERCEL_ENV === 'production'`:
#
#   IS_PRODUCTION_DEPLOY  Anything other than "production" makes every page emit
#                         `<meta name="robots" content="noindex, nofollow">` and
#                         makes /robots.txt say `Disallow: /` with no Sitemap.
#   SHOW_DRAFTS           Anything other than "production" *builds* posts marked
#                         `draft: true` and lists them on /engineering/, badged
#                         "Draft". Only the production deploy omits them, so a
#                         draft is reviewable on any preview deploy with no
#                         extra branch or Vercel configuration. (Who can open a
#                         preview URL is Vercel's Deployment Protection setting,
#                         not something this repo controls.) Drafts stay out of
#                         RSS, related posts and prev/next in every environment.
#
# Set it locally to reproduce a real production build:
#   VERCEL_ENV=production npm run build
# VERCEL_ENV=development
