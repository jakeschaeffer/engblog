{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    // React islands are compiled with the automatic runtime, so components do
    // not need to import React just to use JSX.
    "jsx": "react-jsx",
    "jsxImportSource": "react",

    // Extra strictness on top of astro/tsconfigs/strict. We stop short of
    // `strictest` because `exactOptionalPropertyTypes` fights Astro's own
    // generated prop types for optional component props.
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,

    // `@/*` -> `src/*`. Mirrored in astro.config.mjs (vite.resolve.alias) so
    // the alias resolves at build time as well as at type-check time.
    // No `baseUrl`: it is deprecated in TypeScript 6 and removed in 7, and
    // `paths` entries resolve relative to this file without it.
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    // Astro's generated types (content collection schemas, `astro:*` modules).
    // Regenerated by `astro sync`, which `npm run typecheck`, `astro check` and
    // `astro build` run for us. Do not drop the `astro sync` from `typecheck`:
    // `.astro/` is gitignored, so on a clean checkout (CI) it does not exist and
    // `tsc` cannot resolve `astro:content` or `import.meta.env`.
    ".astro/types.d.ts",
    "**/*",
    "**/*.astro"
  ],
  "exclude": ["dist", "node_modules", ".astro/**/*.astro"]
}
