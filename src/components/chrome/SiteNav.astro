---
/**
 * SiteNav — the primary navigation.
 *
 * Deliberately tiny: two destinations. There is no hamburger, no disclosure
 * button and no client JavaScript — a two-item list wraps onto a second line
 * on a narrow viewport, which is a better outcome than a menu that needs a
 * script to open.
 *
 * The active link is computed at build time from `Astro.url.pathname`, so
 * `aria-current="page"` is correct in the emitted HTML with no hydration.
 */
import { BASE_PATH, RSS_PATH } from '@/lib/site';

interface NavLink {
  readonly href: string;
  readonly label: string;
  /**
   * Feed/asset links are never "the current page" — they are downloads, not
   * documents in the site's page hierarchy — so they opt out of `aria-current`.
   */
  readonly matchable: boolean;
}

const links: readonly NavLink[] = [
  { href: BASE_PATH, label: 'Engineering', matchable: true },
  { href: RSS_PATH, label: 'RSS', matchable: false },
];

/** Compare paths without letting a trailing slash decide the match. */
function normalizePath(pathname: string): string {
  return pathname.length > 1 ? pathname.replace(/\/+$/, '') : pathname;
}

const currentPath = normalizePath(Astro.url.pathname);

function isCurrent(link: NavLink): boolean {
  return link.matchable && normalizePath(link.href) === currentPath;
}
---

<nav class="site-nav" aria-label="Primary">
  <ul class="site-nav__list">
    {
      links.map((link) => (
        <li>
          <a
            class="site-nav__link"
            href={link.href}
            aria-current={isCurrent(link) ? 'page' : undefined}
          >
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .site-nav__list {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-xs) var(--space-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-nav__link {
    display: inline-block;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    text-decoration: none;
    /* A transparent rule reserves the space the active/hover underline needs,
     * so nothing shifts when the state changes. */
    border-block-end: var(--border-width-thick) solid transparent;
    padding-block-end: var(--space-3xs);
  }

  .site-nav__link:hover {
    color: var(--color-text);
    border-block-end-color: var(--color-border-strong);
  }

  .site-nav__link[aria-current='page'] {
    color: var(--color-text);
    border-block-end-color: var(--color-accent);
  }

  .site-nav__link:focus-visible {
    /* Keep the ring clear of the underline rule. */
    outline-offset: var(--focus-ring-offset);
  }
</style>
