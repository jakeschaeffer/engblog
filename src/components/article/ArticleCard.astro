---
/**
 * ArticleCard — one post in an index listing.
 *
 * ## Link pattern
 *
 * The **stretched link** pattern: only the title is a real `<a>`, and a
 * `::after` pseudo-element on it covers the whole card so the entire card is
 * clickable. This keeps exactly one interactive element per card — no nested
 * anchors, no duplicated link text for screen-reader users, and the accessible
 * name of the link is the post title rather than "title, description, date,
 * three tags".
 *
 * The consequence, accepted deliberately: nothing else in the card may be
 * interactive. Tags are therefore rendered as plain text chips, not links.
 * If tag archive pages are ever added, this component has to switch to the
 * "link the title only" pattern (drop the `::after`) rather than nest anchors.
 *
 * ## Heading level
 *
 * Defaults to `<h3>` because the index page puts an `<h2>` section heading
 * above the grid. Callers that need a different level pass `headingLevel`.
 */
import type { CollectionEntry } from 'astro:content';

import { formatDate, toISODateTime } from '@/lib/post-utils';
import { SITE_LANG, postPath } from '@/lib/site';

export interface Props {
  post: CollectionEntry<'posts'>;
  /** Understated emphasis for the lead post on an index. */
  featured?: boolean;
  /** Heading level for the card title. Must fit the page's outline. */
  headingLevel?: 2 | 3 | 4;
}

const { post, featured = false, headingLevel = 3 } = Astro.props;

// Dynamic tag via a lookup so the value is a literal union, not `string`.
const headingTags = { 2: 'h2', 3: 'h3', 4: 'h4' } as const;
const Heading = headingTags[headingLevel];

const { data } = post;
const href = postPath(post.id);

const authorNames = new Intl.ListFormat(SITE_LANG, {
  style: 'long',
  type: 'conjunction',
}).format(data.authors.map((author) => author.name));
---

<article class:list={['card', { 'card--featured': featured }]}>
  {featured && <p class="card__flag">Featured</p>}

  <Heading class="card__title">
    <a class="card__link" href={href}>{data.title}</a>
  </Heading>

  <p class="card__description">{data.description}</p>

  <p class="card__meta">
    <time datetime={toISODateTime(data.publishedAt)}>{formatDate(data.publishedAt)}</time>
    <span class="card__separator" aria-hidden="true">&middot;</span>
    <span>{authorNames}</span>
  </p>

  <ul class="card__tags">
    {data.tags.map((tag) => <li class="card__tag">{tag}</li>)}
  </ul>
</article>

<style>
  .card {
    /* Containing block for the stretched link. */
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    height: 100%;
    padding: var(--space-md);
    border: var(--border);
    border-radius: var(--radius-md);
    background-color: var(--color-surface);
    transition: border-color var(--duration-base) var(--easing);
  }

  .card:hover {
    border-color: var(--color-border-strong);
  }

  /* Featured: a stronger edge, a small label and a larger title. When the card
   * sits in a grid it spans the full row. No colour block, no hero treatment. */
  .card--featured {
    grid-column: 1 / -1;
    border-color: var(--color-border-strong);
  }

  .card__flag {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .card__title {
    margin: 0;
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
  }

  .card--featured .card__title {
    font-size: var(--text-2xl);
  }

  .card__link {
    color: var(--color-text);
    text-decoration: none;
  }

  .card__link:hover {
    color: var(--color-accent-hover);
    text-decoration: underline;
  }

  /* Stretched link: the anchor's own box stays inline (so its focus ring hugs
   * the title text), while this pseudo-element makes the card's whole area
   * activate the same link. */
  .card__link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .card__description {
    margin: 0;
    color: var(--color-text-muted);
    line-height: var(--leading-normal);
    text-wrap: pretty;
  }

  .card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs) var(--space-2xs);
    margin: 0;
    margin-block-start: auto;
    padding-block-start: var(--space-2xs);
    color: var(--color-text-subtle);
    font-size: var(--text-sm);
  }

  .card__separator {
    color: var(--color-border-strong);
  }

  .card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs) var(--space-2xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card__tag {
    padding: 0 var(--space-2xs);
    border: var(--border);
    border-radius: var(--radius-pill);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    line-height: 1.8;
  }
</style>
