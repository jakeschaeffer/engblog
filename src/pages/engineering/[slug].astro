---
/**
 * `/engineering/[slug]` — the article route.
 *
 * ## Which post list drives the paths
 *
 * `getVisiblePosts()`, shared with the publication index. It returns published
 * posts *plus* drafts whenever `SHOW_DRAFTS` is true — the dev server, Vercel
 * preview and branch deploys, CI, and a local `npm run build` — and published
 * posts only on the production deploy. So a draft has a real, shareable page
 * for review, and no page at all in production.
 *
 * Nothing else is needed to keep drafts out of production: a page that is never
 * built cannot appear in `dist/`, cannot be crawled, and cannot be picked up by
 * `@astrojs/sitemap`, which reads the pages that were actually emitted.
 *
 * Related posts and prev/next come from `getPublishedPosts()` instead. That is
 * deliberate, and it is *not* a link-resolution concern — on a build that
 * renders drafts those links would resolve fine. It is editorial: a draft is
 * not part of the reading path between two finished posts, so a reader walking
 * the archive with prev/next never lands in something unpublished.
 *
 * ## The param name
 *
 * The param is `slug` (matching the filename) and its value is `post.id`,
 * because `postPath()` in `@/lib/site` builds URLs from `post.id`. Card links,
 * RSS links, the canonical URL in `PostLayout` and the emitted path therefore
 * all agree by construction. With the `glob` loader, `id` is the file's path
 * relative to the collection base minus the extension.
 *
 * ## MDX components
 *
 * No `components` mapping is passed to `<Content />`. Posts import the
 * components they use explicitly in their own frontmatter (see AUTHORING.md
 * §4), which keeps a post's dependencies visible in the post itself. A global
 * mapping here would silently override the author's imports and make a post's
 * rendering depend on a file it never mentions.
 */
import type { InferGetStaticPropsType } from 'astro';
import { render } from 'astro:content';

import PostLayout from '@/layouts/PostLayout.astro';
import { getAdjacentPosts, getPublishedPosts, getRelatedPosts, getVisiblePosts } from '@/lib/posts';

export async function getStaticPaths() {
  const posts = await getVisiblePosts();

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { post } = Astro.props;

const { Content, headings } = await render(post);

// Navigation targets come from the published list, never the visible one —
// deliberately, in every environment. Drafts stay out of related posts and
// prev/next even on a preview deploy, where they do have pages: they are not
// part of the reading order between published posts.
const publishedPosts = await getPublishedPosts();
const related = getRelatedPosts(post, publishedPosts);
const adjacent = getAdjacentPosts(post, publishedPosts);
---

<PostLayout post={post} headings={headings} related={related} adjacent={adjacent}>
  <Content />
</PostLayout>
